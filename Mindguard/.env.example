# ─────────────────────────────────────────────────────────────────────────────
# CogniGuard environment variables
# Copy to .env for local development. Never commit .env.
# All provider keys below are server-only. Do not prefix them with VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: enables Groq LLM analysis. Without it, analysis falls back to the
# built-in rule-based tier (and remains functional).
GROQ_API_KEY=your_groq_api_key_here

# Optional: enables URL/article extraction.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: enables persistent analysis history. Use the service-role key only
# in the server environment; it must never be exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: enables Hugging Face zero-shot analysis before the Groq fallback.
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: required only for the internal model-evaluation endpoint.
OPENAI_API_KEY=your_openai_api_key_here

# Express server port (default 3001)
PORT=3001

# Allowed browser origin(s), comma-separated. Set this to the deployed frontend
# URL when the frontend and API use different domains.
ALLOWED_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# Leave empty when Vercel serves the frontend and /api from the same domain.
# Set only when hosting the API separately, e.g. https://api.example.com
VITE_API_BASE_URL=
